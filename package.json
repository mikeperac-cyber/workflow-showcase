{
  "name": "workflow-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --workspace @eduflow/api run dev",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:workflows": "tsx src/utils/verifyAIWorkflows.ts",
    "test:unit": "vitest run",
    "test": "npm run test:workflows && npm run test:unit",
    "test:watch": "vitest",
    "analyze": "cross-env ANALYZE=true vite build"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.11.0",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "@tanstack/react-query": "^5.90.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.27",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.71.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}
